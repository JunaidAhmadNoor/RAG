MONGO_URI=mongodb://localhost:27017
MONGO_DB=rag_system
JWT_SECRET_KEY=change-this-secret
JWT_REFRESH_SECRET_KEY=change-this-refresh-secret
# Optional: first superadmin (only created if no superadmin exists). Remove after first deploy.
# Username must NOT already exist (e.g. do not use "admin" if you already registered that workspace admin).
# SUPERADMIN_BOOTSTRAP_USERNAME=superadmin
# SUPERADMIN_BOOTSTRAP_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CHROMA_PERSIST_DIR=./chroma_data
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# On Railway: Ollama service must listen on all interfaces so the API container can reach it:
# set on the Ollama service (not the API): OLLAMA_HOST=0.0.0.0
#
# If private DNS fails (Name or service not known), on the RAG service use either:
# - Variables → Reference → pick Ollama service → RAILWAY_PRIVATE_DOMAIN, then set manually:
#   OLLAMA_BASE_URL=http://<paste-value-only>:11434
# - Or enable Ollama TCP proxy and set:
#   OLLAMA_BASE_URL=http://${{Ollama.RAILWAY_TCP_PROXY_DOMAIN}}:${{Ollama.RAILWAY_TCP_PROXY_PORT}}
#   (namespace must match your Ollama service name in Railway exactly, e.g. Ollama vs ollama)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173
# Optional: override regex for Cloudflare Pages (default in code allows https://*.pages.dev). Set to empty to disable.
# CORS_ORIGIN_REGEX=
